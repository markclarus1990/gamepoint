<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GamepointAgent</RootNamespace>
    <AssemblyName>GamepointAgent</AssemblyName>
    <!-- Version source of truth: build-agent.ps1 / .github/workflows/build-agent.yml
         pass -p:Version / -p:AssemblyVersion / -p:FileVersion /
         -p:InformationalVersion on every publish. Do NOT hardcode them here:
         a stale csproj value would either win over (or confuse) the release
         version and leave agents reporting the wrong version forever. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="bg.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
